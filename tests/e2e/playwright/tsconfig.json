{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@utilities/*": ["utilities/*"],
      "@pages/*": ["pages/*"],
      "@apis/*": ["apis/*"],
      "@testData/*": ["test-data/*"],
      "@shared/*": ["utilities/shared/*"],
      "@helpers/*": ["utilities/helpers/*"]
    },
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  }
} 